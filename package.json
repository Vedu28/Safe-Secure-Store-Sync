{
  "name": "safe-secure-store-sync",
  "version": "1.0.0",
  "description": "Production-ready online file backup system with Firebase auth, MongoDB, and private local storage.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "lint": "node --check server/server.js && node --check server/app.js",
    "seed:indexes": "node server/utils/createIndexes.js",
    "purge:trash": "node server/utils/purgeTrash.js"
  },
  "keywords": [
    "backup",
    "express",
    "firebase",
    "mongodb",
    "storage"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
